.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Corpus and model weights are large and reproducible from scripts; results are not.
data/corpus/
data/**/*.jpg
data/**/*.png
data/**/*.pdf
*.safetensors
*.bin

# Keep results/ and plots/ tracked -- benchmark history is part of the deliverable.
!results/
!results/**/*.json
!results/**/*.jsonl
!results/plots/*.png

# ...except the harness self-test, which is a fake measurement and would only confuse a reader
# browsing results/.
results/dry_run.jsonl

# A resumability cache, not a finding -- regenerable from the corpus in ~1hr/model, and large
# enough (one line per document, one float per hidden dim) not to want in git history.
results/embedding_cache/

.ipynb_checkpoints/
.env

# Personal planning docs -- not part of the deliverable
00_FOUNDATIONS.md
01_EDGERAG.md

# Corpus artifacts are reproducible from scripts/build_corpus.py; images are ~1 GB.
data/corpus.jsonl
data/queries.jsonl
